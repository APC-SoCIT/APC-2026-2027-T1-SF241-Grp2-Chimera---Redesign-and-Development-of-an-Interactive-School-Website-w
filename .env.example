# Local configuration for Vue + Vite and the school backend. Copy to .env.local.
# Both pnpm dev and pnpm dev:server load .env.local; deployment variables win.
# Supabase dashboard > Project Settings > API Keys: use the publishable key.
# Never put sb_secret_, service_role, or a database password in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Scheduling authorization uses the SAME project's public key and the signed-in
# user's bearer token. No service-role/database key is needed for scheduling.
# These server aliases are optional when the VITE_ values above are supplied.
SUPABASE_PUBLISHABLE_KEY=
SCHEDULER_URL=http://127.0.0.1:8766
# Generate a random value of at least 32 characters; server-only, never VITE_.
# The backend launcher passes it to Python automatically in local gateway mode.
SCHEDULER_INTERNAL_SECRET=
SCHEDULER_AUTOSTART=true
# Optional path to Python, and optional SQLite path relative to the repo root.
SCHEDULER_PYTHON=
SCHEDULER_DB=services/scheduler/.local/scheduler.sqlite3

# Enable the browser-local CMS design preview at /admin on a hosted build.
# Set to true only for the demo deployment. This is not production authentication.
VITE_CMS_PREVIEW=
# Public canonical origin for pre-rendered social sharing tags and sitemap.
VITE_SITE_URL=https://sncs-campus-preview.vercel.app

# Additional enrollment/account-management configuration. Scheduling can run
# without these privileged credentials; unconfigured enrollment returns 503.
# Never prefix server secrets with VITE_. Both .env and .env.local are gitignored.
SUPABASE_URL=
# Preferred server key from Supabase Settings → API Keys. Fill one key only.
SUPABASE_SECRET_KEY=
# Legacy alternative when SUPABASE_SECRET_KEY is blank.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Connect → Transaction pooler. Server-only, never VITE_.
DATABASE_URL=
# Optional PEM CA certificate if required by the project's verified TLS connection.
DATABASE_SSL_CA=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=localhost
# Origin has no trailing slash; hostname has no scheme, path, or port.
APP_ORIGIN=http://localhost:5173
# Generate a stable random secret, at least 32 characters. Share across API replicas.
IP_HASH_SECRET=
PORT=3001
HOST=127.0.0.1
# Optional: comma-separated trusted reverse-proxy IPs/CIDRs, never unrestricted true.
TRUSTED_PROXIES=
